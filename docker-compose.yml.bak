services:
  postgres:
    image: postgres:16
    container_name: finsight-postgres
    restart: unless-stopped
    environment:
      POSTGRES_DB: metering_billing
      POSTGRES_USER: metering_user
      POSTGRES_PASSWORD: metering_password
    ports:
      - "5433:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data

  api:
    build: .
    container_name: finsight-api
    restart: unless-stopped
    environment:
      DATABASE_URL: postgresql://metering_user:metering_password@172.19.0.1:5433/metering_billing
      MOCK_WEBHOOK_SECRET: mock_webhook_secret
      INVESTEC_BASE_URL: ${INVESTEC_BASE_URL}
      INVESTEC_CLIENT_ID: ${INVESTEC_CLIENT_ID}
      INVESTEC_CLIENT_SECRET: ${INVESTEC_CLIENT_SECRET}
      INVESTEC_API_KEY: ${INVESTEC_API_KEY}
        ports:
      - "8001:8000"
    depends_on:
      - postgres
    dns:
      - 1.1.1.1
      - 8.8.8.8

volumes:
  postgres_data:
